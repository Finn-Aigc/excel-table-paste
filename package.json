{
  "name": "excel-table-paste",
  "version": "1.0.0",
  "description": "Obsidian plugin that converts pasted Excel or web tables into Markdown tables.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "excel",
    "markdown",
    "table"
  ],
  "author": "Leoz",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
